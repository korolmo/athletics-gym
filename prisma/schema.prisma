// Термины — см. GLOSSARY.md

generator client {
  provider      = "prisma-client-js"
  // Движок запросов под ОС хостинга: дистрибутив и OpenSSL на hoster.kz заранее неизвестны (SSH нет),
  // поэтому в сборку идут все четыре варианта Linux; Prisma сама выбирает подходящий (ADR 0004)
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x"]
}

// MariaDB 10.4 на хостинге (localhost:3306), локально — docker-compose.yml.
// Строки по умолчанию — VARCHAR(191); всё, что может быть длиннее, — @db.Text.
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Категория тарифа: заданы заранее, Владелец их не создаёт
enum TariffCategory {
  /// Разовое посещение
  SINGLE
  /// Абонемент на посещения: N раз в месяц
  VISITS
  /// Безлимит: 1 вход в день на N месяцев
  UNLIMITED
  /// Персональная тренировка
  PERSONAL
}

/// Время доступа
enum Access {
  /// Дневной, 08:00–17:00
  DAY
  /// Весь день, 08:00–23:00 (у зала — «кешкі»)
  FULL
}

/// Аудитория тарифа: проверяет ресепшен, не сайт
enum Audience {
  ALL
  STUDENTS
  WOMEN
  MEN
}

/// Зал — помещение со своим прайсом: general (Общий зал) или women (Женский зал)
model Hall {
  /// "general" | "women"
  id          String    @id
  nameRu      String
  nameKk      String?
  sortOrder   Int       @default(0)
  /// Плакат прайса: путь к Фото в хранилище; пусто — плаката на сайте нет
  pricePoster String?
  tariffs     Tariff[]
  trainers    Trainer[]
  reviews     Review[]
}

/// Тариф — позиция прайса Зала или Тренера (для персональных тренировок)
model Tariff {
  id             String         @id @default(cuid())
  hall           Hall           @relation(fields: [hallId], references: [id])
  hallId         String
  /// Только для PERSONAL: чей это Тариф; пусто — общая позиция прайса Зала
  trainer        Trainer?       @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  trainerId      String?
  category       TariffCategory
  /// Уточнение, которого нет в полях: например «1+1 (подходит для подруг)»
  titleRu        String?
  titleKk        String?
  /// VISITS — посещений в месяц; PERSONAL — тренировок в месяц (пусто = разовая тренировка)
  visitsPerMonth Int?
  /// UNLIMITED — срок в месяцах
  durationMonths Int?
  access         Access         @default(FULL)
  audience       Audience       @default(ALL)
  /// Цена в тенге; при диапазоне — нижняя граница
  price          Int
  /// Верхняя граница диапазона «от–до»
  priceTo        Int?
  isVisible      Boolean        @default(true)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([hallId, category])
  @@index([trainerId])
}

/// Тренер — сотрудник одного Зала, проводит персональные тренировки по своим Тарифам
model Trainer {
  id            String   @id @default(cuid())
  name          String
  hall          Hall     @relation(fields: [hallId], references: [id])
  hallId        String
  /// Путь к карточке-плакату; до этапа 2 — файл из public/trainers/
  photo         String?
  /// Плакат Тренера, загруженный Владельцем: путь к Фото в хранилище. Если задан — показываем его, а не photo
  uploadedPhoto String?
  descriptionRu String? @db.Text
  descriptionKk String? @db.Text
  sortOrder     Int      @default(0)
  isVisible     Boolean  @default(true)
  tariffs       Tariff[]
  /// Часы работы, исключения и длительность тренировки — модуль schedule (этап 1)
  schedule      TrainerSchedule?
  workHours     TrainerWorkHours[]
  timeOff       TrainerTimeOff[]
  bookings      Booking[]

  @@index([hallId])
}

/// Неудачная попытка входа в админку. Нужна для ограничения перебора пароля;
/// IP хранится только в виде хэша.
model LoginAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

/// Аккаунт Владельца — единственная запись (id = "owner").
/// Создаётся при первом входе из ADMIN_LOGIN / ADMIN_PASSWORD, дальше пароль живёт только здесь.
model Owner {
  id             String   @id @default("owner")
  login          String   @unique
  /// bcrypt
  passwordHash   String
  /// Версия сессии: смена пароля и «Выйти на всех устройствах» увеличивают её — старые куки перестают подходить
  sessionVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Настройки сайта — единственная запись (id = "site"): тексты и контакты, которые Владелец меняет сам.
/// RU обязателен, KZ необязателен: пусто → на /kk показываем RU.
model SiteSettings {
  id             String   @id @default("site")
  /// Первый экран: девиз и подзаголовок
  heroTitleRu    String
  heroTitleKk    String?
  heroSubtitleRu String @db.Text
  heroSubtitleKk String? @db.Text
  /// Фон первого экрана: путь к Фото в хранилище; пусто — картинка из public/
  heroPhoto      String?
  /// Женский зал
  womenTextRu    String @db.Text
  womenTextKk    String? @db.Text
  womenInstagram String
  /// Фото Женского зала: путь в хранилище; пусто — показываем логотип Женского зала
  womenPhoto     String?
  /// Контакты
  addressRu      String @db.Text
  addressKk      String? @db.Text
  hoursRu        String
  hoursKk        String?
  /// Телефон: +7 и десять цифр, например +77714846344
  phone          String
  /// Номер WhatsApp: одиннадцать цифр, начиная с 7, — как в ссылке wa.me
  whatsapp       String
  /// Ссылки на Instagram — только вида https://instagram.com/имя
  instagram      String
  /// Рейтинг 2ГИС: оценка в десятых (50 = 5,0) и число оценок — Владелец вводит вручную
  ratingTenths   Int
  ratingCount    Int
  /// Реквизиты: кто ведёт зал и отвечает за сайт. Все необязательны; пока пусты — в подвале сайта их нет
  legalName      String?
  /// ИИН/БИН: ровно 12 цифр
  legalBin       String?
  legalAddress   String? @db.Text
  /// Email для обращений о персональных данных
  privacyEmail   String?
  /// Место хранения данных — продолжение фразы «Данные хранятся …» в Политике конфиденциальности; пусто — текст по умолчанию из кода
  dataLocationRu String? @db.Text
  dataLocationKk String? @db.Text
  /// Бегущая строка: пункты по порядку. Списки одной длины; пустая строка в казахском — «как на русском»
  /// Хранятся как JSON-массив строк в тексте: у MariaDB нет массивов, а её JSON — тот же LONGTEXT
  marqueeRu      String   @db.Text
  marqueeKk      String   @db.Text
  /// Блоки главной: показывать ли на сайте (первый экран не скрывается)
  showMarquee    Boolean  @default(true)
  showAbout      Boolean  @default(true)
  showDirections Boolean  @default(true)
  showWomen      Boolean  @default(true)
  showPrices     Boolean  @default(true)
  showGallery    Boolean  @default(true)
  showTrainers   Boolean  @default(true)
  showContacts   Boolean  @default(true)
  showReviews    Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

/// Карточка блока «О зале»: их всегда четыре, место (1–4) задаёт иконку и порядок.
model AboutCard {
  position Int     @id
  kickerRu String
  kickerKk String?
  titleRu  String
  titleKk  String?
  textRu   String @db.Text
  textKk   String? @db.Text
}

/// Фото Галереи: загружает и упорядочивает Владелец. В базе — только путь к файлу в хранилище.
model GalleryPhoto {
  id        String   @id @default(cuid())
  /// Путь к файлу в хранилище (бакет media), например gallery/<uuid>.webp
  path      String   @unique
  captionRu String?
  captionKk String?
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

/// Источник Отзыва: где он был оставлен
enum ReviewSource {
  /// Форма на сайте
  SITE
  TWOGIS
  INSTAGRAM
  GOOGLE
  OTHER
}

/// Статус Отзыва: на сайте видны только опубликованные
enum ReviewStatus {
  /// Оставлен Посетителем, ждёт решения Владельца
  NEW
  PUBLISHED
  HIDDEN
}

/// Отзыв — реальное мнение клиента о зале. Придуманных Отзывов и демо-данных здесь нет.
model Review {
  id          String       @id @default(cuid())
  authorName  String
  /// Как написан: без перевода и без правок, показывается на обоих языках сайта
  text        String @db.Text
  /// Оценка от 1 до 5
  rating      Int
  hall        Hall?        @relation(fields: [hallId], references: [id], onDelete: SetNull)
  hallId      String?
  source      ReviewSource
  /// Ссылка на оригинал Отзыва — только https
  sourceUrl   String? @db.Text
  /// Дата Отзыва: когда он был написан (у Отзывов с сайта — день отправки)
  reviewedAt  DateTime
  status      ReviewStatus @default(NEW)
  /// Оставлен Посетителем через форму сайта: его текст Владелец не правит — только публикует, скрывает или удаляет
  fromVisitor Boolean      @default(false)
  /// Согласие на обработку данных: когда Посетитель его дал. У Отзывов, добавленных Владельцем, пусто
  consentAt   DateTime?
  /// Дата редакции Политики конфиденциальности, с которой Посетитель согласился («2026-10-11»)
  consentPolicyDate String?
  createdAt   DateTime     @default(now())

  @@index([status, reviewedAt])
}

/// Принятая отправка Отзыва с сайта. Нужна для лимита отправок с одного адреса;
/// IP хранится только в виде хэша, как в LoginAttempt.
model ReviewSubmission {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

/// Обращение — нажатие Посетителя на кнопку связи с залом. Персональных данных нет:
/// только Канал, место на сайте, язык страницы и время. IP и cookies не храним.
model ContactClick {
  id        String   @id @default(cuid())
  /// Канал обращения: whatsapp | phone | instagram
  channel   String
  /// Источник обращения — место на сайте: hero, prices, trainer, contacts, mobile-bar и т. д.
  source    String
  /// Язык страницы: ru | kk
  locale    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Направление — с чем помогают Тренеры зала. Список ведёт Владелец.
model Direction {
  id            String   @id @default(cuid())
  titleRu       String
  titleKk       String?
  /// Короткое описание, до 200 символов
  descriptionRu String? @db.Text
  descriptionKk String? @db.Text
  /// Иконка из набора — ключ из src/modules/directions/domain/direction.ts
  icon          String   @default("exercise")
  /// Своё Фото вместо иконки: путь к файлу в хранилище
  photo         String?
  isVisible     Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([sortOrder])
}

/// Клиент — человек со своим входом в личный кабинет (этап 1, ADR 0016). Храним минимум: телефон (он же логин),
/// имя и Согласие на обработку данных. Удаление аккаунта удаляет запись целиком.
model Client {
  id                String   @id @default(cuid())
  /// Телефон в виде +77XXXXXXXXX — логин Клиента
  phone             String   @unique
  name              String
  /// Версия сессии: «Выйти на всех устройствах» увеличивает её — старые куки перестают подходить
  sessionVersion    Int      @default(1)
  /// Согласие на обработку данных: когда дано и с какой редакцией Политики («2026-11-07»)
  consentAt         DateTime
  consentPolicyDate String
  /// Последний вход: аккаунт без входа дольше срока из правил удаляется
  lastLoginAt       DateTime
  bookings          Booking[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([lastLoginAt])
}

/// Одноразовый код входа Клиента. Хранится только хэш кода; запись удаляется при входе
/// и чистится через сутки. IP — только хэш, для лимита запросов кода.
model ClientLoginCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  ipHash    String
  /// Неверные вводы этого кода
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@index([ipHash, createdAt])
}

/// Настройки записи к Тренеру (этап 1, ADR 0017): длительность одной тренировки. Окна не хранятся —
/// их вычисляет модуль schedule из часов работы и исключений.
model TrainerSchedule {
  trainerId      String   @id
  trainer        Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  /// Длительность тренировки в минутах: 30–180, шаг 15
  sessionMinutes Int      @default(60)
  updatedAt      DateTime @updatedAt
}

/// Интервал работы Тренера в один из дней недели, в поясе Клуба: минуты от полуночи, конец не включается
model TrainerWorkHours {
  id        String  @id @default(cuid())
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  trainerId String
  /// 1 — понедельник … 7 — воскресенье
  weekday   Int
  startMin  Int
  endMin    Int

  @@index([trainerId])
}

/// Исключение: дни (включительно, в поясе Клуба), когда Тренер не принимает записи — выходной, отпуск
model TrainerTimeOff {
  id        String   @id @default(cuid())
  trainer   Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  trainerId String
  /// «2026-11-15»
  fromDay   String
  toDay     String
  /// Подпись для Владельца: «отпуск», «выходной»
  note      String?
  createdAt DateTime @default(now())

  @@index([trainerId, toDay])
}

/// Статус Записи: прошедшая действующая Запись остаётся ACTIVE — «прошла» считается по времени
enum BookingStatus {
  ACTIVE
  CANCELLED
}

/// Запись — персональная тренировка Клиента у Тренера на время (этап 1, ADR 0017).
/// Двойную Запись на одно Окно запрещает уникальный индекс (activeTrainerId, startAt): у действующей Записи
/// activeTrainerId = trainerId, у отменённой — NULL (частичных индексов в MariaDB 10.4 нет, а NULL не мешает уникальности).
model Booking {
  id              String        @id @default(cuid())
  /// Клиент; удалил аккаунт — Запись остаётся без его данных
  client          Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId        String?
  /// Тренер; удалён — Запись остаётся в истории без него
  trainer         Trainer?      @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  trainerId       String?
  /// Копия Зала Тренера на момент Записи
  hallId          String
  startAt         DateTime
  endAt           DateTime
  status          BookingStatus @default(ACTIVE)
  activeTrainerId String?
  /// Ключ повтора из формы: повторная отправка возвращает ту же Запись
  idempotencyKey  String?       @unique
  cancelledAt     DateTime?
  /// Кто отменил: client | owner
  cancelledBy     String?
  createdAt       DateTime      @default(now())

  @@unique([activeTrainerId, startAt])
  @@index([clientId, status, startAt])
  @@index([trainerId, startAt])
  @@index([startAt])
}

/// Состояние события в очереди уведомлений
enum OutboxStatus {
  /// Ждёт отправки (в том числе повторной)
  PENDING
  SENT
  /// Не доставлено после всех попыток — видно в админке
  DEAD
  /// Владелец пометил недоставленное решённым
  RESOLVED
}

/// Событие для уведомления Владельца (этап 1, ADR 0017, transactional outbox): пишется в той же транзакции,
/// что и изменение, которое его вызвало (Запись создана или отменена), отправляется отдельно — сразу после ответа
/// и по расписанию с повторами. Доставка «хотя бы один раз»: повтор сообщения Владелец узнает по номеру события.
model OutboxEvent {
  id            String       @id @default(cuid())
  /// booking.created | booking.cancelled
  type          String
  /// Данные события (JSON): что показать в сообщении
  payload       String       @db.Text
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  /// Когда можно пытаться снова; во время отправки — время, до которого событие занято отправщиком
  nextAttemptAt DateTime     @default(now())
  lastError     String?      @db.Text
  createdAt     DateTime     @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
}

/// Клуб (этап П1, ADR 0018): название, город, бренд и пояс — данные, а не код. Пока одна строка (id «club»);
/// на П2 строк станет больше, а остальные сущности получат ссылку на Клуб. Начальные значения — Athletic's Gym,
/// их вносит миграция один в один с прежними константами кода.
model Club {
  id               String   @id @default("club")
  name             String
  cityRu           String
  cityKk           String?
  /// Описание для поисковиков и превью ссылок
  seoDescriptionRu String   @db.Text
  seoDescriptionKk String?  @db.Text
  /// Год открытия — для подписи «С 2022 года»; пусто — подпись без года
  foundedYear      Int?
  /// Цвет акцента, #rrggbb; цвет текста на нём выбирает правило домена
  accentColor      String
  /// Логотип: путь к Фото в хранилище; пусто — монограмма или логотип из public/
  logoPhoto        String?
  twoGisUrl        String?
  twoGisReviewsUrl String?
  twoGisRouteUrl   String?  @db.Text
  latitude         Float?
  longitude        Float?
  /// IANA-пояс; в админке не меняется — смена пояса сдвигает Записи (П2)
  timeZone         String
  updatedAt        DateTime @updatedAt
}
