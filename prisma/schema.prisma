// Термины — см. GLOSSARY.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Supabase: приложение ходит через пулер (порт 6543), миграции — через session pooler (порт 5432)
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Категория тарифа: заданы заранее, Администратор их не создаёт
enum TariffCategory {
  MONTHLY
  YEARLY
  SINGLE
  PERSONAL
}

enum DurationUnit {
  DAY
  MONTH
  VISIT
}

/// Тариф — позиция прайса
model Tariff {
  id            String         @id @default(cuid())
  category      TariffCategory
  nameRu        String
  nameKk        String?
  descriptionRu String?
  descriptionKk String?
  /// Цена в тенге
  price         Int
  durationValue Int            @default(1)
  durationUnit  DurationUnit
  isVisible     Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

/// Направление — вид групповой тренировки
model Discipline {
  id            String    @id @default(cuid())
  slug          String    @unique
  nameRu        String
  nameKk        String?
  descriptionRu String
  descriptionKk String?
  sortOrder     Int       @default(0)
  trainers      Trainer[]
  lessons       Lesson[]
}

model Trainer {
  id            String       @id @default(cuid())
  nameRu        String
  nameKk        String?
  bioRu         String?
  bioKk         String?
  photoUrl      String?
  takesPersonal Boolean      @default(false)
  isDemo        Boolean      @default(false)
  sortOrder     Int          @default(0)
  disciplines   Discipline[]
  lessons       Lesson[]
}

/// Занятие — строка недельного Расписания
model Lesson {
  id           String     @id @default(cuid())
  /// 1 = понедельник … 7 = воскресенье
  weekday      Int
  /// "HH:MM"
  startTime    String
  durationMin  Int        @default(60)
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  disciplineId String
  trainer      Trainer?   @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  trainerId    String?
  isDemo       Boolean    @default(false)

  @@index([weekday])
}
