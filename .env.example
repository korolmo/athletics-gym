# Supabase → Project → Connect → ORMs → Prisma: скопируйте обе строки.
# Пулер (Transaction mode, порт 6543) — для приложения:
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (порт 5432) — для prisma db push / seed:
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Первый вход в админку (/admin). Аккаунт Владельца хранится в базе: пока его там нет,
# вход по этим логину и паролю создаёт его. Дальше они не используются — пароль меняется в разделе «Аккаунт».
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="change-me"

# Хранилище фото — Supabase Storage того же проекта, что и база. Только для сервера: без NEXT_PUBLIC.
# Supabase → Project Settings → API: Project URL и ключ service_role (секретный, даёт полный доступ к проекту).
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"

# Случайная строка для подписи сессии (минимум 32 символа)
AUTH_SECRET="replace-with-a-long-random-string"
