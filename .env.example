# Supabase → Project → Connect → ORMs → Prisma: скопируйте обе строки.
# Пулер (Transaction mode, порт 6543) — для приложения:
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (порт 5432) — для prisma db push / seed:
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Вход в админку (/admin)
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="change-me"

# Случайная строка для подписи сессии (минимум 32 символа)
AUTH_SECRET="replace-with-a-long-random-string"

# Версия сессий. Увеличьте число и передеплойте, чтобы разом отозвать все входы в админку (необязательно, по умолчанию 1)
# AUTH_SESSION_VERSION="1"
