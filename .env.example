# Локальная база — MariaDB 10.4 в Docker, как на хостинге hoster.kz (ADR 0004): npm run db:up
# root нужен prisma migrate dev (он создаёт временную базу для проверки миграций).
DATABASE_URL="mysql://root:root@localhost:3307/athletics"

# Первый вход в админку (/admin). Аккаунт Владельца хранится в базе: пока его там нет,
# вход по этим логину и паролю создаёт его. Дальше они не используются — пароль меняется в разделе «Аккаунт».
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="change-me"

# Случайная строка для подписи сессии (минимум 32 символа)
AUTH_SECRET="replace-with-a-long-random-string"

# Хранилище Фото: local — папка на диске (по умолчанию), supabase — Supabase Storage (как на Vercel до переезда).
STORAGE_DRIVER="local"
# Папка Фото. Относительный путь — от папки, откуда запущен сервер; по умолчанию — media рядом с папкой приложения.
# На хостинге — папка вне той, что перезаписывает выкатка (docs/hosting-plesk.md).
MEDIA_DIR="./.media"
# Лимит общего объёма Фото, МБ (по умолчанию 500): диск хостинга — 1 ГБ на всё.
# MEDIA_QUOTA_MB="500"

# Среда: production — только на боевом хостинге (индексация, защита seed). Локально не задаём.
# APP_ENV="production"

# Адрес сайта для canonical, hreflang, sitemap и превью ссылок. Необязательно: без неё — https://athleticsgym.kz.
# SITE_URL="https://athleticsgym.kz"

# Код подтверждения Google Search Console (способ «Тег HTML», значение content). Необязательно.
# GOOGLE_SITE_VERIFICATION=""

# Только для STORAGE_DRIVER=supabase и для переноса данных (npm run transfer:export читает .env.preview):
# SUPABASE_URL="https://PROJECT_REF.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
